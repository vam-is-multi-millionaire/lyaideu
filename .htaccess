RewriteEngine On

# --- SEO: canonical host + dynamic sitemap -------------------------------
# Send www.lyaideu.com to lyaideu.com (one canonical hostname for Google).
RewriteCond %{HTTP_HOST} ^www\.lyaideu\.com [NC]
RewriteRule ^(.*)$ https://lyaideu.com/$1 [R=301,L]

# Serve the dynamic sitemap generator at /sitemap.xml
RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

# Optional: force HTTPS once SSL is active in cPanel (AutoSSL). Uncomment both lines.
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://lyaideu.com/$1 [R=301,L]
# --------------------------------------------------------------------------

# /api must always hit api.php, even though a physical api/ dir exists
# (holds api/notifications.php for the live notification feed).
RewriteRule ^api/?$ api.php [QSA,L]

# /store is the Stores page; /store/{id|slug} is a single store's page.
# /hotels and /stores still work too (backwards compatibility).
RewriteRule ^store/?$ store.php [QSA,L]
RewriteRule ^stores/?$ store.php [QSA,L]
RewriteRule ^hotels/?$ store.php [QSA,L]

# Pretty store pages: /store/5  |  /store/himalayan-momo-house
RewriteRule ^store/([0-9]+)/?$ store.php?id=$1 [QSA,L]
RewriteRule ^store/([a-z0-9-]+)/?$ store.php?slug=$1 [QSA,L]

# Existing real files/directories bypass all rewriting (menu.php, mart.php, css, js still work directly)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty product URLs: menu/momo/steamed-momo/chicken-steam-momo  |  mart/vegetables/root-vegetables/fresh-potatoes
# (a trailing numeric id still works: menu/5  |  mart/vegetables/12)
RewriteRule ^(menu|mart|beverages|others)/([0-9]+)/?$                                    product.php?type=$1&id=$2 [QSA,L]
RewriteRule ^(menu|mart|beverages|others)/([a-z0-9-]+)/?$                                product.php?type=$1&slug=$2 [QSA,L]
RewriteRule ^(menu|mart|beverages|others)/((?:[a-z0-9-]+/)*[a-z0-9-]+)/([a-z0-9-]+)/?$    product.php?type=$1&catpath=$2&slug=$3 [QSA,L]

# Legacy /admin_hotels now lives at /admin_vendors (Stores & Vendors).
RewriteRule ^admin_hotels/?$ admin_vendors [R=301,L]

# Extensionless page URLs (internal rewrite): /menu -> menu.php, /login -> login.php, ...
RewriteRule ^(admin_account|admin_activity|admin_beverages|admin_categories|admin_contacts|admin_control|admin_dishes|admin_kyc|admin_mart|admin_messages|admin_orders|admin_others|admin_riders|admin_save|admin_promocodes|admin_sections|admin_settings|admin_team|admin_users|admin_vendors|google_callback|google_login|order_save|order_success|contact_send|index|menu|mart|beverages|others|contact|faq|terms|login|logout|auth|orders|checkout|product|profile|admin|api|vendor|vendor_products|vendor_store|store|rider|categories|section)$ $1.php [QSA,L]