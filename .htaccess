RewriteEngine On

# /api must always hit api.php, even though a physical api/ dir exists
# (holds api/notifications.php for the live notification feed).
RewriteRule ^api/?$ api.php [QSA,L]

# /stores is the Stores page (hotels.php rebranded); /hotels still works too.
RewriteRule ^stores/?$ hotels.php [QSA,L]

# Existing real files/directories bypass all rewriting (menu.php, mart.php, css, js still work directly)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Pretty product URLs: menu/momo/steamed-momo/chicken-steam-momo  |  mart/vegetables/root-vegetables/fresh-potatoes
# (a trailing numeric id still works: menu/5  |  mart/vegetables/12)
RewriteRule ^(menu|mart)/([0-9]+)/?$                                             product.php?type=$1&id=$2 [QSA,L]
RewriteRule ^(menu|mart)/([a-z0-9-]+)/?$                                         product.php?type=$1&slug=$2 [QSA,L]
RewriteRule ^(menu|mart)/((?:[a-z0-9-]+/)*[a-z0-9-]+)/([a-z0-9-]+)/?$             product.php?type=$1&catpath=$2&slug=$3 [QSA,L]

# Extensionless page URLs (internal rewrite): /menu -> menu.php, /login -> login.php, ...
RewriteRule ^(admin_categories|admin_contacts|admin_dishes|admin_hotels|admin_kyc|admin_mart|admin_messages|admin_orders|admin_riders|admin_save|admin_settings|admin_users|admin_vendors|order_save|order_success|contact_send|index|menu|mart|hotels|contact|faq|terms|login|logout|auth|orders|checkout|product|profile|admin|api|vendor|vendor_products|rider)$ $1.php [QSA,L]